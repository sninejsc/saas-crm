<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="crm_team_view_kanban_dashboard_inherit" model="ir.ui.view">
            <field name="name">crm.team.view.kanban.dashboard.inherit</field>
            <field name="model">crm.team</field>
            <field name="inherit_id" ref="sales_team.crm_team_view_kanban_dashboard"/>
            <field name="priority">10</field>
            <field name="arch" type="xml">
                <xpath expr="//kanban/templates/t/div/div[@class='o_kanban_card_manage_settings row']"
                       position="attributes">
                    <attribute name="groups">sales_team.group_sale_manager, intech_crm.group_sbu_manager</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
