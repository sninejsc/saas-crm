<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="inherit.ImportDataContent" t-inherit="base_import.ImportDataContent" t-inherit-mode="extension">
        <xpath expr="//thead/tr[@class='border-bottom']" position="attributes">
            <attribute name="style">display: none !important;</attribute>
        </xpath>
        <xpath expr="//thead/tr[@class='border-bottom']" position="after">
            <tr class="border-bottom">
                <th scope="col" style="width: 20%;">File Column</th>
                <th scope="col" style="width: 20%;">SoOn Field</th>
                <th scope="col">Comments</th>
            </tr>
        </xpath>
    </t>
</templates>
