<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="room_room_form_inherit" model="ir.ui.view">
            <field name="name">room_room_form_inherit</field>
            <field name="model">room.room</field>
            <field name="inherit_id" ref="room.room_room_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet/div[4]/div[1]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//sheet/div[4]/div[1]" position="after">
                    <div>
                        <label for="office_id">Office</label>
                        <h1>
                            <field name="office_id"/>
                        </h1>
                    </div>
                </xpath>
                <xpath expr="//page[@name='Appearance']" position="attributes">
                    <attribute name="string">Appearance</attribute>
                </xpath>
                <xpath expr="//page[@name='Amenities']" position="attributes">
                    <attribute name="string">Amenities</attribute>
                </xpath>
            </field>
        </record>

        <record id="room_room_view_kanban_inherit" model="ir.ui.view">
            <field name="name">room.room.view.kanban.inherit</field>
            <field name="model">room.room</field>
            <field name="inherit_id" ref="room.room_room_view_kanban"/>
            <field name="arch" type="xml">
                <xpath expr="//kanban/templates/t/div/div/div[@class='o_kanban_record_bottom']" position="attributes">
                    <attribute name="style">display: none;</attribute>
                </xpath>

                <xpath expr="//kanban/templates/t/div/div/div[@class='o_kanban_record_bottom']" position="after">
                    <div class="o_kanban_record_bottom">
                        <div t-attf-class="py-1 px-2 text-bg-#{record.is_available.raw_value ? 'success' : 'danger'}">
                            <t t-if="record.is_available.raw_value">Available</t>
                            <t t-else="">Busy</t>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
