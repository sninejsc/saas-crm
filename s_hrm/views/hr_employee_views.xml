<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_employee_form_inherit" model="ir.ui.view">
            <field name="name">view_employee_form_inherit</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet/group/group/field[@name='company_id']" position="after">
                    <field name="state"/>
                </xpath>
                <xpath expr="//header" position="inside">
                    <button name="action_import" string="Import Resume" type="object" class="oe_highlight"/>
                </xpath>
                <xpath expr="//field[@name='mobile_phone']" position="before">
                    <field name="code"/>
                </xpath>
            </field>
        </record>

        <record id="hr_employee_gamification_view_form" model="ir.ui.view">
            <field name="name">hr.employee.gamification.view.form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr_employee_updation.hr_hr_employee_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page/field[@name='badge_ids']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//page/field[@name='badge_ids']" position="after">
                    <field name="badge_ids">
                        <tree editable="bottom">
                            <field name="badge_name"/>
                            <button name="unlink" type="object" icon="fa-trash" class="text-muted"/>
                        </tree>
                    </field>
                </xpath>
            </field>
        </record>

        <record id="hr_employee_resume_view_form" model="ir.ui.view">
            <field name="name">hr.employee.resume.view.form.inherit</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr_skills.hr_employee_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page/div[hasclass('row')]" position="after">
                    <group name="degree_ids" colspan="4" string="Degree Details">
                        <field name="degree_ids">
                            <tree editable="bottom">
                                <field name="name"/>
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="major"/>
                                <field name="certificate"/>
                                <field name="classification"/>
                            </tree>
                        </field>
                    </group>
                </xpath>
            </field>
        </record>

        <record id="view_hr_contract_employee_tree" model="ir.ui.view">
            <field name="name">hr.contract.employee.tree</field>
            <field name="model">hr.contract.employee</field>
            <field name="arch" type="xml">
                <tree string="Contract Status">
                    <field name="employee_name"/>
                    <field name="contract_state"/>
                    <field name="contract_date_end"/>
                </tree>
            </field>
        </record>

        <record id="action_hr_contract_employee" model="ir.actions.act_window">
            <field name="name">Contract Status</field>
            <field name="res_model">hr.contract.employee</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_hr_contract_employee_tree"/>
        </record>
    </data>
</odoo>
