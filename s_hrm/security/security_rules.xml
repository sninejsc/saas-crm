<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--Security Group-->
    <!--Employee-->

    <record id="group_user_employee" model="res.groups">
        <field name="name">Hr Employees</field>
        <field name="category_id" ref="base.module_category_human_resources_employees"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>
    <record id="group_user_hr_sbu" model="res.groups">
        <field name="name">Hr SBU Employees</field>
        <field name="category_id" ref="base.module_category_human_resources_employees"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <!--Contract-->
    <record id="group_hr_contract_user_employee" model="res.groups">
        <field name="name">Employees</field>
        <field name="category_id" ref="base.module_category_human_resources_contracts"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_hr_contract_sbu_hr" model="res.groups">
        <field name="name">HR SBU</field>
        <field name="category_id" ref="base.module_category_human_resources_contracts"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!--Holiday-->
    <record id="group_hr_holiday_user" model="res.groups">
        <field name="name">Employees</field>
        <field name="category_id" ref="base.module_category_human_resources_time_off"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_hr_holiday_leader" model="res.groups">
        <field name="name">Leader</field>
        <field name="category_id" ref="base.module_category_human_resources_time_off"/>
        <field name="implied_ids"
               eval="[(4, ref('hr_holidays.group_hr_holidays_user'))]"/>
    </record>

    <record id="group_hr_holiday_hr_sbu" model="res.groups">
        <field name="name">HR SBU</field>
        <field name="category_id" ref="base.module_category_human_resources_time_off"/>
        <field name="implied_ids" eval="[(4, ref('intech_hrm.group_hr_holiday_user'))]"/>
    </record>

    <record id="group_hr_holiday_dhr" model="res.groups">
        <field name="name">DHR</field>
        <field name="category_id" ref="base.module_category_human_resources_time_off"/>
        <field name="implied_ids" eval="[(4, ref('intech_hrm.group_hr_holiday_user'))]"/>
    </record>

    <!--Attendance-->
    <record id="group_hr_attendance_user_employee" model="res.groups">
        <field name="name">Employees</field>
        <field name="category_id" ref="base.module_category_human_resources_attendances"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_hr_attendance_user_leader" model="res.groups">
        <field name="name">Leader</field>
        <field name="category_id" ref="base.module_category_human_resources_attendances"/>
        <field name="implied_ids" eval="[(4, ref('intech_hrm.group_hr_attendance_user_employee'))]"/>
    </record>
    <record id="group_hr_attendance_sbu_hr" model="res.groups">
        <field name="name">HR SBU</field>
        <field name="category_id" ref="base.module_category_human_resources_attendances"/>
        <field name="implied_ids" eval="[(4, ref('intech_hrm.group_hr_attendance_user_employee'))]"/>
    </record>
    <record id="group_hr_attendance_dhr" model="res.groups">
        <field name="name">DHR</field>
        <field name="category_id" ref="base.module_category_human_resources_attendances"/>
        <field name="implied_ids" eval="[(4, ref('intech_hrm.group_hr_attendance_user_employee')) ]"/>
    </record>

    <!--Security Rule-->

    <!--Room Booking-->
    <record id="room_booking_rule" model="ir.rule">
        <field name="name">Room.booking: Booking rule</field>
        <field name="model_id" ref="room.model_room_booking"/>
        <field name="domain_force">[
            '|',
            '&amp;',
            ('state', '=', 'draft'),
            ('create_uid', '=', user.id),
            ('state', '!=', 'draft'),
            ]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!--Employee-->
    <record id="hr_employee_rule_admin" model="ir.rule">
        <field name="name">Hr.employees: Hr Employee Rule Admin</field>
        <field name="model_id" ref="model_hr_employee"/>
        <field name="domain_force">[(1,'=',1)]
        </field>
        <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="hr_employee_rule_user" model="ir.rule">
        <field name="name">Hr.employees: Hr Employee Rule User</field>
        <field name="model_id" ref="model_hr_employee"/>
        <field name="domain_force">['|',('user_id', '=', user.id),('parent_id', 'child_of', user.employee_id.id)]
        </field>
        <field name="groups" eval="[(4, ref('intech_hrm.group_user_employee'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="hr_employee_rule_hr_sbu" model="ir.rule">
        <field name="name">Hr.employees: Hr Employee Rule Hr SBU</field>
        <field name="model_id" ref="model_hr_employee"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]
        </field>
        <field name="groups" eval="[(4, ref('intech_hrm.group_user_hr_sbu'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--Department-->
    <record id="hr_department_rule_admin" model="ir.rule">
        <field name="name">Hr.department: Hr Department Rule Admin</field>
        <field name="model_id" ref="hr.model_hr_department"/>
        <field name="domain_force">[(1,'=',1)]
        </field>
        <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="hr_department_rule_user" model="ir.rule">
        <field name="name">Hr.department: Hr department Rule User</field>
        <field name="model_id" ref="hr.model_hr_department"/>
        <field name="domain_force">[('manager_id', 'child_of', user.employee_id.id)]
        </field>
        <field name="groups" eval="[(4, ref('intech_hrm.group_user_employee'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_department_rule_hr_sbu" model="ir.rule">
        <field name="name">Hr.department: Hr Employee Rule Hr SBU</field>
        <field name="model_id" ref="hr.model_hr_department"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]
        </field>
        <field name="groups" eval="[(4, ref('intech_hrm.group_user_hr_sbu'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Contract-->
    <record id="hr_contract_user_rule" model="ir.rule">
        <field name="name">Employee: Can see Own Contracts</field>
        <field name="model_id" ref="hr_contract.model_hr_contract"/>
        <field name="domain_force">[('employee_id.user_id','=',user.id)]
        </field>
        <field name="groups" eval="[(4, ref('intech_hrm.group_hr_contract_user_employee'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="hr_contract_hr_sbu_rule" model="ir.rule">
        <field name="name">HR SBU: Can see SBU Contracts</field>
        <field name="model_id" ref="hr_contract.model_hr_contract"/>
        <field name="domain_force">
            [('company_id', 'in', company_ids + [False])]
        </field>
        <field name="groups" eval="[(4, ref('intech_hrm.group_hr_contract_sbu_hr'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Contract SQL View-->
    <record id="hr_contract_employee_sbu_manager" model="ir.rule">
        <field name="name">SBU Manager can see contract</field>
        <field name="model_id" ref="intech_hrm.model_hr_contract_employee"/>
        <field name="domain_force">
            [('employee_id.parent_id.user_id', '=', user.id)]
        </field>
        <field name="groups" eval="[(4, ref('intech_hrm.group_hr_contract_user_employee'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="hr_contract_employee_manager" model="ir.rule">
        <field name="name">Admin can see all contract</field>
        <field name="model_id" ref="intech_hrm.model_hr_contract_employee"/>
        <field name="domain_force">
            [(1, '=', 1)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Holiday-->
    <record id="hr_holiday_user_rule" model="ir.rule">
        <field name="name">User</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">
            [
            ('holiday_type', '=', 'employee'),
            '|',
            '&amp;',
            '|',
            ('employee_id.user_id', '=', user.id),
            ('state', '!=', 'validate'),
            ('employee_id.leave_manager_id', '=', user.id),
            ('employee_id', 'child_of', user.employee_id.id)
            ]
        </field>
        <field name="groups" eval="[(4, ref('intech_hrm.group_hr_holiday_user'))]"/>
    </record>

    <record id="hr_holiday_dhr_rule" model="ir.rule">
        <field name="name">DHR</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('intech_hrm.group_hr_holiday_dhr'))]"/>
    </record>

    <record id="hr_holidays.hr_leave_rule_user_read" model="ir.rule">
        <field name="domain_force">[('employee_id', 'child_of', user.employee_id.id)]</field>
    </record>

    <!--Attendance-->
    <record id="hr_attendance_rule_user" model="ir.rule">
        <field name="name">Hr.attendance: Hr Attendance Rule User</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="domain_force">['|',('employee_id.user_id', '=', user.id),('employee_id.parent_id.user_id', '=',
            user.id)]
        </field>
        <field name="groups" eval="[(4, ref('intech_hrm.group_hr_attendance_user_employee'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="hr_attendance_rule_hr_sbu" model="ir.rule">
        <field name="name">Hr.attendance: Hr Attendance Rule Hr SBU</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="domain_force">[('employee_id.company_id', 'in', company_ids + [False])]</field>
        <field name="groups" eval="[(4, ref('intech_hrm.group_hr_attendance_user_leader'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="hr_attendance_rule_dhr" model="ir.rule">
        <field name="name">Hr.attendance: Hr Attendance Rule DHR</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="domain_force">[('employee_id.company_id', 'in', company_ids + [False])]
        </field>
        <field name="groups" eval="[(4, ref('intech_hrm.group_hr_attendance_dhr'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <!--Treat Complain-->
    <record id="hr_treat_complain_user" model="ir.rule">
        <field name="name">Treat.complain: Treat Complain Rule User</field>
        <field name="model_id" ref="s_attendance.model_treat_complain"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id),('state', '=', 'waiting_approval')]</field>
        <field name="groups" eval="[(4, ref('intech_hrm.group_hr_attendance_user_employee'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="hr_treat_complain_rule_leader" model="ir.rule">
        <field name="name">Treat.complain: Treat Complain Rule Leader</field>
        <field name="model_id" ref="s_attendance.model_treat_complain"/>
        <field name="domain_force">[('employee_id.parent_id.user_id', '=', user.id),('employee_id.user_id', '!=',
            user.id)]
        </field>
        <field name="groups" eval="[(4, ref('intech_hrm.group_hr_attendance_user_leader'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="hr_treat_complain_rule_hr_sbu" model="ir.rule">
        <field name="name">Treat.complain: Treat Complain Rule Hr SBU</field>
        <field name="model_id" ref="s_attendance.model_treat_complain"/>
        <field name="domain_force">[('employee_id.company_id', 'in', company_ids + [False])]</field>
        <field name="groups" eval="[(4, ref('intech_hrm.group_hr_attendance_sbu_hr'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="hr_treat_complain_rule_dhr" model="ir.rule">
        <field name="name">Treat.complain: Treat Complain Rule DHR</field>
        <field name="model_id" ref="s_attendance.model_treat_complain"/>
        <field name="domain_force">[('employee_id.company_id', 'in', company_ids + [False])]
        </field>
        <field name="groups" eval="[(4, ref('intech_hrm.group_hr_attendance_dhr'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
